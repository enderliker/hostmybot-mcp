{
  "name": "hostmybot-mcp",
  "version": "1.0.1",
  "description": "MCP server for HostMyBot / Pterodactyl Client API (servers, files, power, console, backups, schedules, startup, subusers)",
  "license": "MIT",
  "author": "enderliker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enderliker/hostmybot-mcp.git"
  },
  "homepage": "https://github.com/enderliker/hostmybot-mcp#readme",
  "bugs": {
    "url": "https://github.com/enderliker/hostmybot-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hostmybot",
    "pterodactyl",
    "wings",
    "ai-agent"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hostmybot-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "build": "tsc && chmod +x dist/index.js",
